# ==============================================================================
# CampusRide — Frontend Environment Configuration (.env)
# ==============================================================================
# Copy this file to `client/.env` to configure your Vite frontend environment.

# URL of the backend API server (defaults to http://localhost:5000 in dev)
VITE_API_URL=http://localhost:5000

# Optional: Carto Maps API Key for Carto Voyager map tiles
VITE_CARTO_API_KEY=

